# Engineering defaults; copy manually only when needed (06-CREATE-LOCAL-ENV.cmd copies this file to .env).
# No production secrets here. Docker Compose reads .env automatically for the ${...} values in compose.yaml.
NODE_ENV=development
API_HOST=127.0.0.1
API_PORT=3000
# Local (non-Docker) development. Inside Compose the API always uses mongodb://mongo:27017/elay.
MONGODB_URI=mongodb://127.0.0.1:27017/elay
MEDIA_DIR=./data/media
PUBLIC_MENU_URL=
# Supply the existing printed-QR URL during deployment; do not invent or change it.
# Session cookies are Secure by default (browsers allow this on http://localhost).
# Set to false only for plain-HTTP testing from another device on the LAN.
COOKIE_SECURE=true
SESSION_TTL_HOURS=12
TRUST_PROXY=false
LOGIN_RATE_LIMIT_PER_15M=10
# Host port for the web container.
WEB_PORT=8080
