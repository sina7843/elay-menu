{
  "name": "@elay/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx watch --env-file-if-exists=../../.env src/server.ts",
    "start": "node dist/server.js",
    "create-super-admin": "node dist/cli/create-super-admin.js",
    "seed:demo": "node dist/cli/seed-demo.js",
    "test": "vitest run"
  },
  "dependencies": {
