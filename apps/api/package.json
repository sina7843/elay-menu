    "@fastify/cookie": "^11.0.2",
    "@fastify/rate-limit": "^10.3.0",
    "fastify": "^5.6.1",
    "mongodb": "^6.20.0",
    "sharp": "^0.35.5",
    "zod": "^4.1.12"
  },
  "devDependencies": {
    "@types/node": "^24.7.0",
    "mongodb-memory-server": "^10.2.3",
    "tsx": "^4.20.6",
    "typescript": "~5.9.3",
    "vitest": "^5.0.3"
  }
