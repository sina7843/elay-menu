# Environment variables to set in Coolify for compose.coolify.yaml. No secrets are needed.
# The exact URL printed on the table QR codes (the domain assigned to the web service). Required.
PUBLIC_MENU_URL=https://YOUR_DOMAIN
# Keep true: Coolify serves the site over HTTPS.
COOKIE_SECURE=true
SESSION_TTL_HOURS=12
LOGIN_RATE_LIMIT_PER_15M=10
